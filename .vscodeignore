# media/mcpBridge.js must stay in the package: it is not bundled, it is copied
# out and run as a standalone process by editors that configure MCP from a file.

# Explicitly include non-bundled node_modules
# !node_modules
node_modules/marked

node_modules/monaco-editor/**
